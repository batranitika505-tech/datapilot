# Database Credentials (individual settings)
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datapilot

# Optional full database URL (takes precedence over individual DB_* settings)
# DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/datapilot

# Optional SQLAlchemy Connection Pool Settings
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Isolated Test Database URL
# TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/datapilot_test
